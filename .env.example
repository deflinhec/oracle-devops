# Logging (optional)
LOG_LEVEL=info
LOG_ENCODING=json
LOG_OUTPUT_PATHS=stdout
LOG_ERROR_OUTPUT_PATHS=stderr

# MariaDB
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=oracle_db
DB_USERNAME=oracle
DB_PASSWORD=oracle_password
DB_ROOT_PASSWORD=root_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka
KAFKA_BROKERS=kafka01:9092,kafka02:9092,kafka03:9092

# Kafka Connect
KAFKA_CONNECT_URL=http://kafka-connect:8083
KAFKA_CONNECT_SERVER_ID=1
KAFKA_CONNECT_BROKERS=kafka01:9092,kafka02:9092,kafka03:9092
KAFKA_CONNECT_DATABASE_HOST=mariadb
KAFKA_CONNECT_DATABASE_PORT=3306
KAFKA_CONNECT_DATABASE_USERNAME=connect
KAFKA_CONNECT_DATABASE_PASSWORD=connect_password

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=oracle_analytics
CLICKHOUSE_USERNAME=oracle
CLICKHOUSE_PASSWORD=oracle_password

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=oracle_mdb
MONGODB_USERNAME=oracle
MONGODB_PASSWORD=oracle_password
MONGODB_AUTH_SOURCE=admin

# CloudBeaver
CLOUDBEAVER_ADMIN_NAME=cbadmin
CLOUDBEAVER_ADMIN_PASSWORD=cbadmin

# Mongo Express
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=admin
